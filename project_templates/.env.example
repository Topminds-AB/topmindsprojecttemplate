# ==============================================================================
# Topminds — Universal .env.example (v1.0)
# Purpose:
# - Standardized environment variable set usable across most projects.
# - Safe to commit: ALL values are empty or non-secret placeholders.
# - Keep names stable over time to reduce friction across repos.
#
# Conventions:
# - APP_*  : application/runtime config
# - DB_*   : primary production database (usually remote / managed)
# - MYSQL_*: local/dev MySQL (docker compose / local workstation)
# - REDIS_*: cache/session store
# - SMTP_* : outbound email
# - AI_*   : LLM providers + routing defaults
# - OLLAMA_* / KBWHISPER_* : local AI services
# - STORAGE_* / S3_* / FTP_* : file storage
# - AUTH_* / OAUTH_* : auth providers
# - OBS_*  : observability (logs/metrics/tracing)
#
# NOTE:
# - Do NOT put secrets here. Use .env (ignored) for real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# App identity / environment
# ------------------------------------------------------------------------------
APP_NAME=
APP_ENV=                  # local | dev | test | staging | prod
APP_REGION=               # eu-north-1 | eu-west-1 | etc
APP_LOCALE=               # sv-SE | en-US
APP_TIMEZONE=             # Europe/Stockholm
APP_INSTANCE_ID=          # optional, e.g. hostname/container id

# ------------------------------------------------------------------------------
# URLs / routing
# ------------------------------------------------------------------------------
BASE_URL=                 # canonical base URL for backend/API (e.g. https://api.example.com)
SITE_URL=                 # canonical base URL for frontend/site (e.g. https://example.com)
API_BASE_URL=             # optional explicit API base URL (if different from BASE_URL)
PUBLIC_BASE_URL=          # optional public URL used in emails/links (if different)
ASSETS_BASE_URL=          # optional CDN/assets base URL

# ------------------------------------------------------------------------------
# Runtime toggles
# ------------------------------------------------------------------------------
DEBUG=                    # true|false
LOG_LEVEL=                # debug|info|warn|error
TIMEOUT_SECONDS=          # default outbound request timeout (seconds)
SESSION_LIFETIME_MINUTES= # default session lifetime
COOKIE_SECURE=            # true|false (usually true in prod)
COOKIE_SAMESITE=          # Lax|Strict|None
CORS_ALLOWED_ORIGINS=     # comma-separated origins
ALLOWED_HOSTS=            # comma-separated hosts/domains

# ------------------------------------------------------------------------------
# Security / crypto
# ------------------------------------------------------------------------------
APP_SECRET_KEY=           # framework secret (Django/Flask/etc)
JWT_SECRET=               # signing secret (if using symmetric JWT)
JWT_ISSUER=               # optional
JWT_AUDIENCE=             # optional
JWT_EXPIRES_MINUTES=      # optional
ENCRYPTION_KEY=           # optional app-level encryption key
PASSWORD_PEPPER=          # optional

# ------------------------------------------------------------------------------
# Feature flags (generic)
# ------------------------------------------------------------------------------
FEATURE_FLAGS=            # comma-separated, e.g. new-ui,fast-search
MAINTENANCE_MODE=         # true|false

# ------------------------------------------------------------------------------
# Database — Production / primary (DB_*)
# ------------------------------------------------------------------------------
DB_ENGINE=                # mysql|postgres|mariadb|sqlite
DB_HOST=                  # production DB host
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=              # disable|prefer|required|verify-ca|verify-full (varies by engine)
DB_SSL_CA_PATH=           # optional
DB_SSL_CERT_PATH=         # optional
DB_SSL_KEY_PATH=          # optional
DB_CONNECT_TIMEOUT_SECONDS=
DB_POOL_MIN=
DB_POOL_MAX=
DB_MIGRATIONS_AUTO_RUN=   # true|false
DB_READONLY_HOST=         # optional read replica host
DB_READONLY_PORT=         # optional
DB_READONLY_USER=         # optional
DB_READONLY_PASSWORD=     # optional

# ------------------------------------------------------------------------------
# MySQL — Local/dev (MYSQL_*)
# Used for docker compose local stacks or workstation DB.
# ------------------------------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_URL=                # optional full connection string

# ------------------------------------------------------------------------------
# Postgres — Local/dev (optional if you sometimes use Postgres)
# ------------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=             # optional full connection string

# ------------------------------------------------------------------------------
# Redis / cache / sessions
# ------------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=
REDIS_URL=
CACHE_TTL_SECONDS=
SESSION_STORE=            # cookie|redis|db

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=              # none|starttls|ssl
SMTP_TIMEOUT_SECONDS=
SMTP_DEBUG=               # true|false
EMAIL_PROVIDER=           # smtp|ses|sendgrid|mailgun|postmark|other

# Optional provider-specific
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
POSTMARK_API_KEY=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# FTP / SFTP (legacy integrations)
# ------------------------------------------------------------------------------
FTP_HOST=
FTP_PORT=
FTP_USER=
FTP_PASSWORD=
FTP_PATH=                 # remote base path
FTP_SECURE=               # true|false (FTPS)
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_KNOWN_HOSTS_PATH=

# ------------------------------------------------------------------------------
# Object storage (S3-compatible, Azure, GCS) + local storage
# ------------------------------------------------------------------------------
STORAGE_DRIVER=           # local|s3|gcs|azure
STORAGE_LOCAL_PATH=       # e.g. ./data/storage
STORAGE_PUBLIC_URL=       # optional public URL for stored objects

# S3 compatible
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=                # optional path prefix inside bucket
S3_FORCE_PATH_STYLE=      # true|false

# Google Cloud Storage
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=          # keep empty; store in secret manager or .env (not committed)

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ENDPOINT_SUFFIX=

# ------------------------------------------------------------------------------
# Webhooks / external integrations (generic)
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=
EXTERNAL_API_TIMEOUT_SECONDS=
EXTERNAL_API_RETRIES=

# ------------------------------------------------------------------------------
# Observability (logging/metrics/tracing)
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLER=      # always_on|always_off|traceidratio
OTEL_TRACES_SAMPLER_ARG=  # e.g. 0.1
PROMETHEUS_ENABLED=       # true|false
PROMETHEUS_PORT=

# ------------------------------------------------------------------------------
# Authentication / Identity (generic)
# ------------------------------------------------------------------------------
AUTH_MODE=                # local|oauth|oidc|saml|keycloak
AUTH_BASE_URL=            # if you have an auth service
AUTH_CALLBACK_URL=        # frontend/backend callback URL
AUTH_SESSION_COOKIE_NAME=
AUTH_ALLOWED_EMAIL_DOMAINS=# comma-separated

# Keycloak / OIDC
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=              # space-separated
OIDC_JWKS_CACHE_SECONDS=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OAuth / Entra ID
MS_OAUTH_TENANT_ID=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# AI routing (generic) — choose defaults without locking to one provider
# ------------------------------------------------------------------------------
AI_PROVIDER_DEFAULT=      # openai|anthropic|google|perplexity|grok|ollama|custom
AI_MODEL_DEFAULT=         # e.g. gpt-4.1-mini / claude-3.5-sonnet / gemini-1.5-pro etc
AI_TEMPERATURE_DEFAULT=
AI_MAX_TOKENS_DEFAULT=
AI_TOP_P_DEFAULT=
AI_REQUEST_TIMEOUT_SECONDS=
AI_RETRIES=
AI_LOG_REQUESTS=          # true|false (careful with PII)
AI_LOG_RESPONSES=         # true|false (careful with PII)
AI_SAFE_MODE=             # true|false (provider-agnostic guardrail toggle)

# ------------------------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=          # optional override (proxy/self-hosted gateway)
OPENAI_DEFAULT_MODEL=
OPENAI_EMBEDDINGS_MODEL=
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_TIMEOUT_SECONDS=

# ------------------------------------------------------------------------------
# Anthropic
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=       # optional
ANTHROPIC_DEFAULT_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=

# ------------------------------------------------------------------------------
# Google AI (Gemini)
# ------------------------------------------------------------------------------
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=       # optional
GOOGLE_AI_DEFAULT_MODEL=
GOOGLE_AI_TIMEOUT_SECONDS=

# ------------------------------------------------------------------------------
# Perplexity
# ------------------------------------------------------------------------------
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=      # optional
PERPLEXITY_DEFAULT_MODEL=
PERPLEXITY_TIMEOUT_SECONDS=

# ------------------------------------------------------------------------------
# xAI (Grok)
# ------------------------------------------------------------------------------
XAI_API_KEY=
XAI_BASE_URL=             # optional
XAI_DEFAULT_MODEL=
XAI_TIMEOUT_SECONDS=

# ------------------------------------------------------------------------------
# Local AI — Ollama
# ------------------------------------------------------------------------------
OLLAMA_HOST=              # e.g. http://localhost:11434
OLLAMA_DEFAULT_MODEL=
OLLAMA_EMBEDDINGS_MODEL=
OLLAMA_TIMEOUT_SECONDS=
OLLAMA_KEEP_ALIVE=        # optional keep-alive hint (varies by client)
OLLAMA_NUM_CTX=           # optional context window override
OLLAMA_NUM_GPU=           # optional

# ------------------------------------------------------------------------------
# Local AI — KBWhisper (your internal/local transcription service)
# ------------------------------------------------------------------------------
KBWHISPER_HOST=           # e.g. http://localhost:9000
KBWHISPER_API_KEY=        # if you protect it locally
KBWHISPER_MODEL=
KBWHISPER_LANGUAGE=       # e.g. sv|en
KBWHISPER_TIMEOUT_SECONDS=
KBWHISPER_OUTPUT_FORMAT=  # txt|srt|vtt|json

# ------------------------------------------------------------------------------
# Vector DB / embeddings store (optional but common)
# ------------------------------------------------------------------------------
VECTOR_STORE=             # qdrant|pgvector|pinecone|weaviate|milvus|redis|none

# Qdrant
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_HTTPS=             # true|false

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=

# Weaviate
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Milvus
MILVUS_HOST=
MILVUS_PORT=
MILVUS_USER=
MILVUS_PASSWORD=

# ------------------------------------------------------------------------------
# Background jobs / queues (optional)
# ------------------------------------------------------------------------------
QUEUE_DRIVER=             # none|redis|rabbitmq|sqs
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
AWS_SQS_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ------------------------------------------------------------------------------
# File processing / media (optional)
# ------------------------------------------------------------------------------
FFMPEG_PATH=
TEMP_DIR=
MAX_UPLOAD_MB=
ALLOWED_UPLOAD_MIME_TYPES= # comma-separated

# ------------------------------------------------------------------------------
# Rate limiting / abuse control (optional)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=       # true|false
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_BURST=

# ------------------------------------------------------------------------------
# Payments / billing (optional)
# ------------------------------------------------------------------------------
BILLING_PROVIDER=         # none|stripe|paddle|adyen
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ------------------------------------------------------------------------------
# Analytics (optional)
# ------------------------------------------------------------------------------
ANALYTICS_PROVIDER=       # none|plausible|ga|mixpanel
PLAUSIBLE_DOMAIN=
GA_MEASUREMENT_ID=
MIXPANEL_TOKEN=

# ------------------------------------------------------------------------------
# Misc (escape hatch)
# ------------------------------------------------------------------------------
CUSTOM_CONFIG_JSON=        # optional JSON string for rare cases
