# ==============================================================================
# Topminds — Universal .gitignore (v1.0)
# Goal: safe defaults across Python/Node/PHP/Docker + media-heavy projects.
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets / environment
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# Common secret files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.kdb
*.kubeconfig
*.ovpn

# ------------------------------------------------------------------------------
# OS / editor / IDE
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.stackdump

.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/
*.iml

# ------------------------------------------------------------------------------
# Logs / temp
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
tmp/
temp/
.cache/
.npmrc.local

# ------------------------------------------------------------------------------
# Build artifacts
# ------------------------------------------------------------------------------
dist/
build/
out/
target/
*.min.js
*.min.css
*.map

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
*.egg-info/
.eggs/
.venv/
venv/
ENV/
env/
pip-wheel-metadata/
*.sqlite3
*.db
*.db-journal

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Node / JS / TS
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
.nuxt/
.svelte-kit/
.turbo/
.eslintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# PHP / Composer
# ------------------------------------------------------------------------------
vendor/
composer.phar
.phpunit.result.cache

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
*.pid
docker-data/
.docker/
.dockerlogs/
.dockerlogs/**
docker-compose.override.yml

# ------------------------------------------------------------------------------
# Databases / backups / snapshots (Topminds conventions)
# ------------------------------------------------------------------------------
.codebasebackup/
.codebasebackup/**
.dbdump/
.dbdump/**
.dbbackup/
.dbbackup/**
manifest/
manifest/**

# NOTE: If you WANT manifest committed, remove the two lines above and commit it.
# Many teams keep manifest inside snapshots only.

# ------------------------------------------------------------------------------
# Media / large binaries
# ------------------------------------------------------------------------------
# Video
*.mp4
*.mkv
*.mov
*.avi
*.wmv
*.flv
*.webm
*.m4v
*.mts
*.m2ts
*.3gp

# Audio
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.opus

# Images (optional: keep if you store lots of raw media; remove if you need images in git)
*.psd
*.ai
*.sketch

# Archives / exports (optional; keep snapshots separate)
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz

# ------------------------------------------------------------------------------
# Test artifacts / reports
# ------------------------------------------------------------------------------
test-results/
playwright-report/
coverage-report/
reports/
junit*.xml

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
*.bak
*.swp
*.swo
*.orig
*.rej

# Local data folders
data/
storage/
uploads/

# Runtime sockets
*.sock
