#
# Generated for: {{ system_slug }} ({{ hostname }})
# Generated at:  {{ generated_at }}
# Redirect to:   {{ redirect_target }}

http:
  routers:
    docs-{{ system_slug }}:
      rule: "Host(`{{ hostname }}`)"
      entryPoints:
        - web
      middlewares:
        - docs-{{ system_slug }}-headers
        - docs-{{ system_slug }}-redirect
      service: docs-{{ system_slug }}

  middlewares:
    # Tell Wiki.js the original request was HTTPS (Cloudflare terminates TLS)
    docs-{{ system_slug }}-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"

    # Redirect bare hostname / to the system's L2 page with default-locale param
    docs-{{ system_slug }}-redirect:
      redirectRegex:
        regex: "^https?://{{ hostname_regex }}/?$"
        replacement: "https://{{ hostname }}{{ redirect_target }}"
        permanent: false

  services:
    docs-{{ system_slug }}:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ wikijs_backend_url }}"
